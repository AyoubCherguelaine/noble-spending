# PostgreSQL connection string for local development (Neon/Supabase/etc.).
# Netlify Database provides NETLIFY_DB_URL automatically in deployed runtimes.
DATABASE_URL=

# JWT signing secret (64 hex characters / 32 bytes).
# If set, the .jwt-secret file is ignored and this value is used instead.
JWT_SECRET=

# Default credentials used on first run if no auth user exists in the database.
AUTH_USERNAME=
AUTH_PASSWORD=


# Google OAuth for Gmail integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Token encryption key for Gmail OAuth tokens (AES-256-GCM)
TOKEN_ENCRYPTION_KEY=
